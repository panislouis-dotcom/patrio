# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=patrio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres      # production: openssl rand -hex 32

# ─── API ─────────────────────────────────────────────────────────────────────
# Dev: localhost:5432  |  Production: db:5432 (compose service name)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patrio
JWT_SECRET=change-me-to-a-long-random-secret   # production: openssl rand -hex 32
ALLOWED_ORIGINS=http://localhost:5173           # production: https://your-domain.com

# ─── Web (Vite) ──────────────────────────────────────────────────────────────
# Dev: point at local API  |  Production: leave empty (relative /api/* requests)
VITE_API_BASE=http://localhost:8000

# ─── LLM ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                 # required — get from console.anthropic.com
# Claude lee imágenes pero no las genera: los renders salen de OpenAI images.edit.
OPENAI_API_KEY=                    # required for renders — platform.openai.com
OPENAI_IMAGE_MODEL=                # optional — default gpt-image-2

# ─── Auth ────────────────────────────────────────────────────────────────────
# ADMIN_EMAIL define quién es admin (routes/users.py lo compara por correo).
# ADMIN_PASSWORD_HASH es un hash bcrypt YA calculado, para desplegar sin poner
# una contraseña en claro. `make create-user` NO lo imprime — crea al usuario
# directo en la base—, así que para desarrollo local no uses esto: usa el bloque
# de abajo, que toma la contraseña en claro y la hashea al arrancar el API.
ADMIN_EMAIL=admin@patrio.mx
ADMIN_PASSWORD_HASH=

# ─── Test ────────────────────────────────────────────────────────────────────
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patrio_test

# ─── Usuario de desarrollo local ─────────────────────────────────────────────
# CON ESTO SE ENTRA A LA APP EN LOCAL. Si están puestos, el API siembra la
# cuenta al arrancar (`main.py::_seed_smoke_user`): contraseña EN CLARO, la
# hashea él. Sin ellos una base recién migrada no tiene ni un usuario y no hay
# por dónde entrar.
#
# `test@refigan.com` es el correo que ya usan el E2E y CI
# (`app/e2e/tests/01-auth.spec.ts`, `.github/workflows/ci.yml`). La contraseña
# de CI NO es ésta: se genera al vuelo por corrida (`openssl rand -hex 16`),
# así que ésta es de local y de nadie más.
#
# DÉJALOS VACÍOS EN CUALQUIER AMBIENTE DESPLEGADO: el sembrado no distingue a
# qué base apunta `DATABASE_URL`, así que puestos en producción crearían una
# cuenta con contraseña conocida.
SMOKE_EMAIL=test@refigan.com
SMOKE_PASS=test1234
