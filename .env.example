# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=refigan
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres      # production: openssl rand -hex 32

# ─── API ─────────────────────────────────────────────────────────────────────
# Dev: localhost:5432  |  Production: db:5432 (compose service name)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/refigan
JWT_SECRET=change-me-to-a-long-random-secret   # production: openssl rand -hex 32
ALLOWED_ORIGINS=http://localhost:5173           # production: https://your-domain.com

# ─── Web (Vite) ──────────────────────────────────────────────────────────────
# Dev: point at local API  |  Production: leave empty (relative /api/* requests)
VITE_API_BASE=http://localhost:8000

# ─── LLM ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                 # required — get from console.anthropic.com

# ─── Auth ────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=            # generate: make create-user  then copy hash here

# ─── Test ────────────────────────────────────────────────────────────────────
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/refigan_test

# ─── Deploy  (Taskfile.yml — not used by docker-compose) ─────────────────────
DEPLOY_HOST=                    # VM IP or hostname, e.g. 123.45.67.89
DEPLOY_USER=ubuntu              # SSH user on VM
DEPLOY_KEY=~/.ssh/refigan-prod  # local path to private SSH key
DEPLOY_PATH=/opt/refigan        # directory on VM where repo is synced
